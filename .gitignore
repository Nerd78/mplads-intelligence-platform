/MPLADS.csv
/principal_master_*.csv
/principal_master_*.json
/mplads-scraper/data/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Env files (see .env.example in backend/ and mplads-ai-pulse-main/)
.env
.env.local

# Detection engine model artifact -- regenerated by run_detection.py
backend/detection/model.joblib

# OS / editor cruft
.DS_Store
Thumbs.db

